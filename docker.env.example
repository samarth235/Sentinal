# Copy to .env for `docker compose up`. Secrets must be long random strings:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
NODE_ENV=production
API_TOKEN=admin:change-me-to-a-long-random-string
AGENT_API_KEYS=my-agent:change-me-to-another-long-random-string
POSTGRES_PASSWORD=change-me
PUBLIC_API_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:8080

GROQ_API_KEY=
GROQ_MODEL=
ALLOW_HEURISTIC_GUARD=false
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
ENABLE_DEMO_FEATURES=false
