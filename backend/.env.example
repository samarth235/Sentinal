ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=4000
POLICY_PATH=./src/policy/policy.yaml
APPROVAL_TIMEOUT_SECONDS=60

DATABASE_URL=                 # if empty -> in-memory hash chain mirrored to audit.jsonl
GROQ_API_KEY=
GROQ_MODEL=                   # pick a current fast instruction model from the Groq console
GUARD_TIMEOUT_MS=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=     # only this chat may approve/reject
TELEGRAM_ALLOWED_USER_IDS=    # optional comma list; only these users may approve (set when the chat is a group)
FRONTEND_ORIGIN=http://localhost:5173
ENABLE_TAMPER_DEMO=true       # never true in a real deployment
API_TOKEN=                    # bearer token for POST /api/*; required when NODE_ENV=production
