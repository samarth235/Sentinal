# ---- Core -------------------------------------------------------------------
PORT=4000
# NODE_ENV=production            # deployment checks: API_TOKEN required (24+ chars)
SENTINEL_MODE=demo               # "production" = strict: no shield-off, reset or tamper demo; Groq guard required
# POLICY_PATH=./my-policy.yaml   # default: the bundled src/policy/policy.yaml

# Operator tokens for the dashboard and every /api route (except health/ready/ui-config).
# Named form records WHO approved:  API_TOKEN=alice:<secret>,bob:<secret>
# Required in production (24+ chars). Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_TOKEN=
# Keys for agents using the gateway API (/api/v1) and the SDK:  AGENT_API_KEYS=support-bot:<secret>
AGENT_API_KEYS=
FRONTEND_ORIGIN=http://localhost:5173

# ---- Integrations (each falls back to a local stub when unset) ----------------
DATABASE_URL=                 # Postgres (Neon/Supabase). Empty -> hash chain in memory + audit.jsonl
GROQ_API_KEY=
GROQ_MODEL=                   # a current fast instruction model from the Groq console
GUARD_TIMEOUT_MS=3000
ANTHROPIC_API_KEY=            # live mode (Claude runs the demo scenarios)
ANTHROPIC_MODEL=claude-sonnet-5-5

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=     # only this chat may approve/reject or run commands
TELEGRAM_ALLOWED_USER_IDS=    # comma list; recommended for groups
TELEGRAM_NOTIFY_DENY=true     # also message on outright DENY
TELEGRAM_ENABLE_OVERRIDE=false  # /override from chat; off by design (needs TELEGRAM_ALLOWED_USER_IDS, never in production mode)
TELEGRAM_WEBHOOK_URL=         # public backend URL -> webhook mode (needed with >1 replica)
TELEGRAM_WEBHOOK_SECRET=      # required with TELEGRAM_WEBHOOK_URL

# ---- Behaviour ----------------------------------------------------------------
# APPROVAL_TIMEOUT_SECONDS=60   # default: policy.yaml defaults.approval_timeout_seconds
ENABLE_TAMPER_DEMO=true       # demo mode only; never on a real deployment
ENABLE_REAL_BROWSE=false      # browse_url fetches real public pages (SSRF-guarded) for live mode
AUDIT_VERIFY_INTERVAL_MINUTES=15
AUDIT_ANCHOR_INTERVAL_MINUTES=60   # post the chain head hash to Telegram (external anchor)
RATE_LIMIT_PER_MINUTE=300
# TRUST_PROXY=1                 # default 1 in production (Railway/Render sit behind one proxy)
